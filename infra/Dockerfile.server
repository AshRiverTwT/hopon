FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p hopon-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/hopon-server /usr/local/bin/hopon-server
EXPOSE 8080
CMD ["hopon-server"]
