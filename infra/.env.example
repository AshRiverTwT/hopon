POSTGRES_PASSWORD=change-me
HOPON_JWT_SECRET=change-me-to-32+-random-bytes
LIVEKIT_API_KEY=hopon
LIVEKIT_API_SECRET=change-me-to-32+-random-bytes
# What clients use to reach the SFU (wss:// behind TLS in production).
LIVEKIT_PUBLIC_URL=ws://YOUR_HOST:7880
TURN_HOST=YOUR_HOST
# Public IPv4 for coturn behind NAT (defaults to TURN_HOST when it is an IP)
#TURN_EXTERNAL_IP=
TURN_PASSWORD=change-me
# false for a LAN-only test setup
USE_EXTERNAL_IP=true
