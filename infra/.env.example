POSTGRES_PASSWORD=change-me
HOPON_JWT_SECRET=change-me-to-32+-random-bytes
LIVEKIT_API_KEY=hopon
LIVEKIT_API_SECRET=change-me-to-32+-random-bytes
# What clients use to reach the SFU (wss:// behind TLS in production).
LIVEKIT_PUBLIC_URL=ws://YOUR_HOST:7880
TURN_HOST=YOUR_HOST
# Public IPv4 for coturn behind NAT (defaults to TURN_HOST when it is an IP)
#TURN_EXTERNAL_IP=
TURN_PASSWORD=change-me
# false for a LAN-only test setup
USE_EXTERNAL_IP=true
# Attachments: max file size, per-user total, and the free disk space that
# uploads may never eat into (protects Postgres on the same disk).
#HOPON_MAX_UPLOAD_MB=25
#HOPON_USER_QUOTA_MB=1024
#HOPON_MIN_FREE_MB=2048
# GIF search: free key from https://klipy.com/developers (empty = GIFs off)
KLIPY_API_KEY=
