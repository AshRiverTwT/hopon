# coturn: TURN fallback for clients that cannot reach the SFU over UDP.
listening-port=3478
fingerprint
lt-cred-mech
user=hopon:@TURN_PASSWORD@
realm=hopon
# Behind NAT (e.g. AWS EC2) relay candidates must carry the public IP.
@EXTERNAL_IP_LINE@
min-port=50300
max-port=50400
no-cli
no-tlsv1
no-tlsv1_1
# Never relay into private networks.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
