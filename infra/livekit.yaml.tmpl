# LiveKit SFU tuned for low-latency voice. Rendered by render-config.sh.
port: 7880
log_level: info
rtc:
  # UDP media. Open these on the firewall.
  port_range_start: 50000
  port_range_end: 50200
  tcp_port: 7881            # ICE-TCP fallback before TURN
  use_external_ip: @USE_EXTERNAL_IP@
  # TURN only as a last resort (coturn, turnserver.conf).
  turn_servers:
    - host: @TURN_HOST@
      port: 3478
      protocol: udp
      username: hopon
      credential: @TURN_PASSWORD@
    - host: @TURN_HOST@
      port: 3478
      protocol: tcp
      username: hopon
      credential: @TURN_PASSWORD@
keys:
  @LIVEKIT_API_KEY@: @LIVEKIT_API_SECRET@
audio:
  # Speaking indicators every 100 ms instead of the 500 ms default.
  update_interval: 100
  smooth_intervals: 1
  active_level: 35
  min_percentile: 40
room:
  empty_timeout: 30
  max_participants: 25
