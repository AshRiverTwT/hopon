{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HopOn",
  "version": "0.4.1",
  "identifier": "app.hopon.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "HopOn",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "backgroundColor": "#161515",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost wss: https: ws: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
