<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side of the native bridge: P/Invoke into hopon_ffi (generated by
       client/ffi/build.rs) plus a small async wrapper. No UI code; the WinUI
       shell references this. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>HopOn.Native</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ffi/bindings/NativeMethods.g.cs" Link="NativeMethods.g.cs" />
  </ItemGroup>
</Project>
