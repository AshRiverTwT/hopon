<!-- HopOn's look (client/ui/src/styles.css, "INSTRUMENT" + "signal orange"):
     warm black, cream type, one hot accent; square corners, flat colour, hairlines;
     Archivo Expanded titles, Geist text, Geist Mono for every label and number.
     Overrides WinUI's theme resources so stock controls (dialogs, menus, text
     boxes, list rows) follow it too. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- palette -->
    <Color x:Key="InkColor">#0B0B0C</Color>
    <Color x:Key="Ink2Color">#151516</Color>
    <Color x:Key="CreamColor">#EDEDEE</Color>
    <Color x:Key="SignalColor">#FF5B1F</Color>
    <SolidColorBrush x:Key="Ink" Color="#0B0B0C" />
    <SolidColorBrush x:Key="Ink2" Color="#151516" />
    <SolidColorBrush x:Key="Key" Color="#161617" />
    <SolidColorBrush x:Key="KeyHi" Color="#1E1E20" />
    <SolidColorBrush x:Key="Cream" Color="#EDEDEE" />
    <SolidColorBrush x:Key="Cream80" Color="#CCEDEDEE" />
    <SolidColorBrush x:Key="Cream55" Color="#8CEDEDEE" />
    <SolidColorBrush x:Key="Cream35" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="Cream20" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="Cream10" Color="#1AEDEDEE" />
    <SolidColorBrush x:Key="Cream05" Color="#0DEDEDEE" />
    <SolidColorBrush x:Key="Hair" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Signal" Color="#FF5B1F" />
    <SolidColorBrush x:Key="SignalSoft" Color="#12FF5B1F" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />

    <!-- type -->
    <FontFamily x:Key="TextFont">ms-appx:///Fonts/HopOnText-Regular.ttf#HopOn Text, ms-appx:///Fonts/Twemoji.ttf#Twemoji Mozilla</FontFamily>
    <FontFamily x:Key="TextMediumFont">ms-appx:///Fonts/HopOnText-Medium.ttf#HopOn Text, ms-appx:///Fonts/Twemoji.ttf#Twemoji Mozilla</FontFamily>
    <FontFamily x:Key="TextSemiFont">ms-appx:///Fonts/HopOnText-SemiBold.ttf#HopOn Text, ms-appx:///Fonts/Twemoji.ttf#Twemoji Mozilla</FontFamily>
    <FontFamily x:Key="MonoFont">ms-appx:///Fonts/HopOnMono-Regular.ttf#HopOn Mono</FontFamily>
    <FontFamily x:Key="MonoMediumFont">ms-appx:///Fonts/HopOnMono-Medium.ttf#HopOn Mono</FontFamily>
    <FontFamily x:Key="MonoSemiFont">ms-appx:///Fonts/HopOnMono-SemiBold.ttf#HopOn Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">ms-appx:///Fonts/HopOnDisplay-Black.ttf#HopOn Display</FontFamily>
    <FontFamily x:Key="CondensedFont">ms-appx:///Fonts/HopOnCondensed-Regular.ttf#HopOn Condensed</FontFamily>

    <!-- stock controls: default font, square corners, flat dark surfaces -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Fonts/HopOnText-Regular.ttf#HopOn Text, ms-appx:///Fonts/Twemoji.ttf#Twemoji Mozilla</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0B0B0C" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8CEDEDEE" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#EDEDEE" />

    <!-- buttons are "keys": #161617, hairline border, cream text -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#161617" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E20" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E1E20" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0F0F10" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#CCEDEDEE" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EDEDEE" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EDEDEE" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#EDEDEE" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0B0C" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0B0C" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B0B0C" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#8CEDEDEE" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#EDEDEE" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#EDEDEE" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0B0B0C" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0B0B0C" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0B0B0C" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#EDEDEE" />

    <!-- text boxes are a line: transparent, a hairline underneath, bright when focused -->
    <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#59EDEDEE" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#8CEDEDEE" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#EDEDEE" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#8CEDEDEE" />

    <!-- links: cream-55, cream on hover, no underline or fill -->
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#8CEDEDEE" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#EDEDEE" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#EDEDEE" />
    <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />

    <!-- list rows: a key-coloured hover, no selection pill -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0DEDEDEE" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#161617" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#161617" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1E1E20" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#1E1E20" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FF5B1F" />

    <!-- surfaces above the page: dialogs, menus, flyouts -->
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#151516" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#151516" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#B3000000" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#151516" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1AEDEDEE" />
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#151516" />
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#EDEDEE" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#0B0B0C" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#EDEDEE" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33EDEDEE" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#151516" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#EDEDEE" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0B0B0C" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#EDEDEE" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#EDEDEE" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#EDEDEE" />
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#EDEDEE" />
    <Color x:Key="SystemAccentColor">#EDEDEE</Color>
    <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorLight2">#FFFFFF</Color>
    <Color x:Key="SystemAccentColorDark1">#CCCCCC</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#EDEDEE" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCEDEDEE" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B0B0C" />
</ResourceDictionary>
