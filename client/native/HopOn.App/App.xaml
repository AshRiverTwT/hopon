<Application
    x:Class="HopOn.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Theme-keyed copies, so stock control templates pick them up. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Theme.xaml" />
                <ResourceDictionary x:Key="Default" Source="ms-appx:///Theme.xaml" />
            </ResourceDictionary.ThemeDictionaries>

            <!-- HUD label: mono caps, wide tracking (.eyebrow) -->
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="CharacterSpacing" Value="160" />
                <Setter Property="Foreground" Value="{StaticResource Cream55}" />
            </Style>
            <!-- Archivo Expanded Black titles (.display) -->
            <Style x:Key="Display" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="Foreground" Value="{StaticResource Cream}" />
                <Setter Property="CharacterSpacing" Value="10" />
                <Setter Property="LineHeight" Value="0" />
                <Setter Property="TextLineBounds" Value="Tight" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <!-- "key": a hardware-style button (.pill) -->
            <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
            <Style x:Key="SolidKeyButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource MonoSemiFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
            <!-- icon key in the toolbar strip -->
            <Style x:Key="IconKey" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Foreground" Value="{StaticResource Cream55}" />
            </Style>
            <!-- borderless icon button (header) -->
            <Style x:Key="BareIcon" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Foreground" Value="{StaticResource Cream80}" />
            </Style>
            <!-- .link: quiet text button -->
            <Style x:Key="Link" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Cream55}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- 16×16 stroked icon, 1.5 px, from icons.tsx -->
            <Style x:Key="Glyph" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stroke" Value="{StaticResource Cream80}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Stretch" Value="None" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
