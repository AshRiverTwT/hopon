<Window
    x:Class="HopOn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HopOn.App"
    Title="HopOn">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Splash: still signing in with the saved login. -->
        <StackPanel x:Name="SplashView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="HopOn" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <ProgressRing IsActive="True" Width="28" Height="28" />
        </StackPanel>

        <!-- Sign in / sign up. -->
        <StackPanel x:Name="LoginView" Visibility="Collapsed" Width="320"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="HopOn" FontSize="34" FontWeight="SemiBold" />
            <TextBox x:Name="UserBox" Header="Username" />
            <PasswordBox x:Name="PassBox" Header="Password" KeyDown="OnPasswordKeyDown" />
            <TextBox x:Name="UrlBox" Header="Server" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" Click="OnSignIn" />
                <Button x:Name="SignUpButton" Content="Create account" Click="OnSignUp" />
            </StackPanel>
            <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <!-- Signed in. -->
        <Grid x:Name="ShellView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Servers -->
            <ListView x:Name="ServerList" Grid.Column="0" Padding="0,8"
                      Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
                      ItemsSource="{x:Bind Store.Servers}" SelectionMode="Single"
                      SelectionChanged="OnServerSelected">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ServerVm">
                        <Border Width="46" Height="46" CornerRadius="16" Margin="0,4"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Initials, Mode=OneWay}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Channels -->
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ServerTitle" Margin="16,16,16,8" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <ListView x:Name="ChannelList" Grid.Row="1" ItemsSource="{x:Bind Store.Channels}"
                          SelectionMode="Single" SelectionChanged="OnChannelSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelVm">
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Opacity="{x:Bind LabelOpacity, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" Margin="16,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="MeText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ConnText" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Sign out" Click="OnSignOut" VerticalAlignment="Center" FontSize="12" Padding="8,3" />
                </Grid>
            </Grid>

            <!-- Chat -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="20,14,20,10">
                    <TextBlock x:Name="ChannelTitle" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChannelTopic" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Virtualized. KeepItemsInView: older pages load above without moving
                     what you're reading; the window follows new messages only at the bottom. -->
                <ListView x:Name="MessageList" Grid.Row="1" ItemsSource="{x:Bind Store.Messages}"
                          SelectionMode="None" IsItemClickEnabled="False" Loaded="OnMessageListLoaded">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="20,1" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MessageVm">
                            <StackPanel Padding="{x:Bind RowPadding, Mode=OneWay}" Opacity="{x:Bind Opacity, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HeaderVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Author, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Time}" FontSize="12" Opacity="0.55" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <RichTextBlock local:RichView.Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Visibility="{x:Bind BodyVisibility, Mode=OneWay}" />
                                <!-- Poll: options with vote bars; votes are 1️⃣–5️⃣ reactions. -->
                                <StackPanel Visibility="{x:Bind PollVisibility, Mode=OneWay}" Spacing="6" MaxWidth="440" HorizontalAlignment="Left"
                                            Padding="12" CornerRadius="8" Margin="0,4,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind Poll.Question, Mode=OneWay, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{x:Bind PollOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:PollOptionVm">
                                                <Button Click="{x:Bind Toggle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2">
                                                    <Grid ColumnSpacing="12" MinWidth="300">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.ColumnSpan="2" Value="{x:Bind Pct, Mode=OneWay}" Maximum="100" VerticalAlignment="Bottom" Opacity="0.6" />
                                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind VotesText, Mode=OneWay}" Opacity="0.7" FontSize="12" Margin="0,0,0,6" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- Reactions -->
                                <ItemsControl ItemsSource="{x:Bind Chips}" Visibility="{x:Bind ChipsVisibility, Mode=OneWay}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ReactionVm">
                                            <Button Click="{x:Bind Toggle}" Content="{x:Bind Label, Mode=OneWay}" Opacity="{x:Bind ChipOpacity, Mode=OneWay}"
                                                    Padding="8,2" MinHeight="0" CornerRadius="10" FontSize="13" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Edited, Mode=OneWay}" FontSize="11" Opacity="0.5" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBox x:Name="Composer" Grid.Row="2" Margin="20,8,20,0" PlaceholderText="Message"
                         PreviewKeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged" />
                <TextBlock x:Name="TypingText" Grid.Row="3" Margin="22,4,20,8" FontSize="12" Opacity="0.7" MinHeight="16" />
            </Grid>
        </Grid>

        <InfoBar x:Name="Toast" IsOpen="False" Severity="Informational" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" MaxWidth="560" />
    </Grid>
</Window>
