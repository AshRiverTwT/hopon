<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end check of the native bridge: real C# → hopon_ffi → server.
       See Program.cs for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HopOn.Interop/HopOn.Interop.csproj" />
  </ItemGroup>
</Project>
